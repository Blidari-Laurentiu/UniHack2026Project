DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://newcomer-hub/api
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
DEMO_CACHE=0
CORS_ORIGINS=http://localhost:5173
# Student verification emails. MAIL_FROM must be a sender verified in Brevo.
# Nothing set in dev: the code is printed in the server log instead.
# Test the setup: cd backend && python -m services.mailer you@example.com
MAIL_FROM=Newcomer Hub <you@example.com>
BREVO_API_KEY=
# Alternative to Brevo (not on Render's free plan, it blocks SMTP ports):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APP_ENV=dev
