DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://newcomer-hub/api
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
DEMO_CACHE=0
CORS_ORIGINS=http://localhost:5173
# Student verification emails. Empty SMTP_HOST in dev: the code is printed in the server log.
# Gmail: smtp.gmail.com, port 587, an app password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Newcomer Hub <you@example.com>
APP_ENV=dev
