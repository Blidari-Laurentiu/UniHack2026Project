VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://newcomer-hub/api
VITE_API_URL=http://localhost:8000
# Optional, dev only: when set, requests send X-Dev-User instead of a Bearer token
# (works only while the backend runs with APP_ENV=dev).
VITE_DEV_USER=
# Optional, with VITE_DEV_USER: the roles to act with (creator, moderator, admin), comma separated.
VITE_DEV_ROLES=
